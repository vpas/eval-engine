# keep the build context small + never ship secrets or local state into the image
.git/
**/.venv/
**/.data/
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/.pytest_cache/
.env
.env.*
.mcp.json
*.log
# keep most of deploy/ out of the context, but the image needs deploy/sandbox/ (helm values)
deploy/terraform/
deploy/k8s/
docs/
infra/
tests/
frontend/
get_helm.sh
