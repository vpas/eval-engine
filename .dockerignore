# keep the build context small + never ship secrets or local state into the image
.git/
**/.venv/
**/.data/
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/.pytest_cache/
.env
.env.*
.mcp.json
*.log
# the Dockerfile copies only eval_engine/ static/ examples/ pyproject.toml — keep the rest out of context
deploy/
docs/
infra/
tests/
get_helm.sh
